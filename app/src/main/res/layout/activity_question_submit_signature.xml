<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c_transparent_black"
    >
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:layout_margin="@dimen/d_30dp"
        >
    <include
        android:id="@+id/header"
        layout="@layout/include_header_text"
        />
<LinearLayout
    android:id="@+id/ll_image_container"
    android:layout_width="match_parent"
    android:layout_height="450dp"
    android:layout_centerInParent="true"
    android:orientation="vertical">
        <ImageView
            android:id="@+id/iv_signature_image"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_gravity="center_horizontal"
            android:src="@mipmap/white_logo_splash"/>
    <LinearLayout
        android:id="@+id/ll_delete"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:layout_margin="16dp">

        <TextView
            android:id="@+id/tv_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/c_blue"
            android:layout_weight="1"
            android:padding="10dp"
            android:layout_marginRight="2dp"
            android:textColor="@color/c_white"
            android:gravity="center"
            android:text="@string/cancel" />

        <TextView
            android:id="@+id/tv_delete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:padding="10dp"
            android:gravity="center"
            android:background="@color/c_blue"
            android:layout_weight="1"
            android:textColor="@color/c_white"
            android:text="@string/delete" />
    </LinearLayout>

</LinearLayout>

    <com.github.gcacace.signaturepad.views.SignaturePad
        android:id="@+id/signature_pad"
        android:layout_above="@+id/buttons_container"
        android:layout_below="@+id/et_name"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />

    <LinearLayout
        android:id="@+id/buttons_container"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:paddingTop="16dp">

        <Button
            android:id="@+id/clear_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/c_blue"
            android:layout_weight="1"
            android:padding="10dp"
            android:layout_marginRight="2dp"
            android:textColor="@color/c_white"
            android:enabled="false"
            android:text="@string/text_clear_pad" />

        <Button
            android:id="@+id/save_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:padding="10dp"
            android:background="@color/c_blue"
            android:layout_weight="1"
            android:textColor="@color/c_white"
            android:enabled="false"
            android:text="@string/text_save" />
    </LinearLayout>

    <include
        android:layout_width="@dimen/d_progressbar"
        android:layout_height="@dimen/d_progressbar"
        android:layout_centerInParent="true"
        layout="@layout/spunk_view"
        />
</RelativeLayout>
</RelativeLayout>